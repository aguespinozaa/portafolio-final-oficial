<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portafolio | Agustina Espinoza</title>

    <style>

        /* ==========================================
           CONFIGURACIÓN GENERAL
        ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: #33232d;
            overflow-x: hidden;

            background:
                radial-gradient(circle at 8% 15%, #ff9dc8 0%, transparent 28%),
                radial-gradient(circle at 91% 14%, #ffbd7c 0%, transparent 28%),
                radial-gradient(circle at 55% 85%, #d8a7ea 0%, transparent 32%),
                linear-gradient(
                    135deg,
                    #fff5eb,
                    #ffd9e5 45%,
                    #ffd1b7 75%,
                    #f8b1d1
                );

            background-attachment: fixed;
        }


        /* ==========================================
           ESTRELLAS DECORATIVAS DEL FONDO
        ========================================== */

        .background-stars {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .bg-star {
            position: absolute;
            color: rgba(255,255,255,0.75);
            font-family: Georgia, serif;
            text-shadow: 0 5px 20px rgba(169, 65, 116, 0.15);
        }

        .bg1 {
            top: 5%;
            left: 5%;
            font-size: 70px;
            transform: rotate(-12deg);
        }

        .bg2 {
            top: 18%;
            right: 5%;
            font-size: 42px;
            color: #ffe574;
        }

        .bg3 {
            top: 52%;
            left: 2%;
            font-size: 55px;
            color: rgba(255,255,255,0.55);
        }

        .bg4 {
            bottom: 8%;
            right: 4%;
            font-size: 75px;
            color: rgba(255, 121, 177, 0.45);
        }


        /* ==========================================
           PORTADA GENERAL
        ========================================== */

        header {
            min-height: 460px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 70px 20px 55px;
        }

        .hero {
            width: 100%;
            max-width: 1050px;
        }

        .nombre {
            font-family: Georgia, "Times New Roman", serif;
            text-transform: uppercase;
            letter-spacing: 5px;
            font-size: 0.9rem;
            margin-bottom: 22px;
            color: #513743;
        }


        /* ==========================================
           TITULO ESTILO REVISTA RECORTADA
        ========================================== */

        .titulo-revista {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            max-width: 1000px;
            margin: auto;
        }

        .espacio {
            width: 22px;
        }

        .letra {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 49px;
            height: 72px;
            padding: 5px 10px;
            font-size: 3.8rem;
            font-weight: 900;
            line-height: 1;
            text-transform: uppercase;

            box-shadow:
                3px 5px 0 rgba(67,35,50,0.08);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .letra:hover {
            transform: translateY(-7px) rotate(4deg);
            box-shadow:
                5px 10px 15px rgba(67,35,50,0.12);
        }

        .l1 {
            background: #f5d8b7;
            color: #40647a;
            font-family: Georgia, serif;
            transform: rotate(-5deg);
        }

        .l2 {
            background: #ef779e;
            color: #fff9ee;
            font-family: Impact, sans-serif;
            transform: rotate(4deg);
        }

        .l3 {
            background: #ffd15f;
            color: #c64076;
            font-family: Georgia, serif;
            transform: rotate(-3deg);
        }

        .l4 {
            background: #78c5bb;
            color: white;
            font-family: Arial Black, sans-serif;
            transform: rotate(4deg);
        }

        .l5 {
            background: #ff9374;
            color: #412d39;
            font-family: Georgia, serif;
            transform: rotate(-4deg);
        }

        .l6 {
            background: #dec3ec;
            color: #476179;
            font-family: Impact, sans-serif;
            transform: rotate(3deg);
        }

        .l7 {
            background: #f5ead6;
            color: #d95083;
            font-family: "Times New Roman", serif;
            transform: rotate(-3deg);
        }

        .l8 {
            background: #589286;
            color: white;
            font-family: Arial Black, sans-serif;
            transform: rotate(4deg);
        }

        .l9 {
            background: #ffd766;
            color: #bd4272;
            font-family: Georgia, serif;
            transform: rotate(-4deg);
        }

        .l10 {
            background: #ea81ad;
            color: white;
            font-family: Impact, sans-serif;
            transform: rotate(3deg);
        }

        .l11 {
            background: #efb38e;
            color: #365970;
            font-family: Georgia, serif;
            transform: rotate(-3deg);
        }

        .l12 {
            background: #89bed2;
            color: #fff9ee;
            font-family: Arial Black, sans-serif;
            transform: rotate(4deg);
        }


        .asignatura {
            margin-top: 30px;
            font-size: 1.12rem;
            font-weight: 600;
            color: #49323e;
        }

        .subtitulo {
            margin-top: 9px;
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            color: #80636f;
            font-size: 0.96rem;
        }


        /* ==========================================
           CONTENEDOR PRINCIPAL
        ========================================== */

        .container {
            width: min(1200px, calc(100% - 40px));
            margin: auto;
            padding-bottom: 80px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 30px;

            border-bottom: 1px solid rgba(79,45,60,0.18);

            padding-bottom: 16px;
            margin-bottom: 25px;
        }

        .section-header h2 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 2rem;
            font-weight: normal;
        }

        .section-header span {
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.72rem;
            color: #8c6b7a;
        }


        /* ==========================================
           GRID
        ========================================== */

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }


        /* ==========================================
           TARJETAS
        ========================================== */

        .card {
            display: flex;
            flex-direction: column;

            background: rgba(255,250,246,0.75);

            border: 1px solid rgba(255,255,255,0.75);

            border-radius: 25px;

            overflow: hidden;

            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            box-shadow:
                0 18px 45px rgba(112,51,79,0.14);

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow:
                0 28px 60px rgba(112,51,79,0.22);
        }


        /* ==========================================
           PORTADAS
        ========================================== */

        .cover {
            position: relative;
            height: 255px;
            margin: 10px;
            overflow: hidden;
            border-radius: 18px;
        }


        /* ==========================================
           PORTADA 1
           JUEGO MUSICAL
        ========================================== */

        .cover-musica {
            background:
                radial-gradient(
                    circle at 30% 30%,
                    #ffd77d 0%,
                    #ff8278 17%,
                    transparent 37%
                ),

                radial-gradient(
                    circle at 75% 70%,
                    #ed4a99 0%,
                    #b75ec0 28%,
                    transparent 52%
                ),

                linear-gradient(
                    145deg,
                    #213a73,
                    #f1559e 48%,
                    #ff744c
                );
        }

        .cover-musica::before {
            content: "";
            position: absolute;

            width: 190px;
            height: 190px;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    circle at 50% 25%,
                    #ffc760 0%,
                    #ff6d71 20%,
                    #e84c9c 39%,
                    #213365 68%,
                    #ff694a 100%
                );

            box-shadow:
                inset 0 0 20px rgba(255,255,255,0.25),
                0 15px 30px rgba(28,23,60,0.25);
        }

        .cover-musica::after {
            content: "♪";
            position: absolute;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            color: rgba(255,255,255,0.9);

            font-size: 65px;

            font-family: Georgia, serif;
        }


        /* ==========================================
           PORTADA 2
           TRANSCRIPTOR
        ========================================== */

        .cover-voz {
            background:
                radial-gradient(
                    circle at 17% 20%,
                    #ff8c59 0%,
                    transparent 37%
                ),

                radial-gradient(
                    circle at 82% 22%,
                    #6c578d 0%,
                    transparent 37%
                ),

                radial-gradient(
                    circle at 65% 80%,
                    #ff809f 0%,
                    transparent 43%
                ),

                linear-gradient(
                    135deg,
                    #e9cadf,
                    #cca8de,
                    #ff9671
                );
        }

        .sound-wave {
            position: absolute;
            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sound-wave span {
            display: block;
            width: 7px;
            border-radius: 20px;
            background: rgba(255,255,255,0.85);
        }

        .sound-wave span:nth-child(1) { height: 35px; }
        .sound-wave span:nth-child(2) { height: 65px; }
        .sound-wave span:nth-child(3) { height: 95px; }
        .sound-wave span:nth-child(4) { height: 55px; }
        .sound-wave span:nth-child(5) { height: 78px; }
        .sound-wave span:nth-child(6) { height: 42px; }


        /* ==========================================
           PORTADA 3
           PROYECTO INTERFAZ
        ========================================== */

        .cover-interfaz {
            background:
                radial-gradient(
                    circle at 25% 20%,
                    #ff748f,
                    transparent 35%
                ),

                radial-gradient(
                    circle at 75% 25%,
                    #49c1b6,
                    transparent 35%
                ),

                radial-gradient(
                    circle at 65% 80%,
                    #ff722e,
                    transparent 42%
                ),

                linear-gradient(
                    140deg,
                    #ff9db0,
                    #183746,
                    #ff7a33
                );
        }

        .orb {
            position: absolute;

            width: 185px;
            height: 185px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%)
                rotate(10deg);

            border-radius:
                46% 54% 61% 39% /
                45% 45% 55% 55%;

            background:
                radial-gradient(
                    circle at 70% 72%,
                    #ff943d,
                    #ff5e55 30%,
                    #123c46 51%,
                    #4ab7ad 72%,
                    #ff778e
                );

            border:
                2px solid
                rgba(255,255,255,0.42);

            box-shadow:
                inset 0 0 28px
                rgba(255,255,255,0.18),

                0 18px 35px
                rgba(44,21,37,0.22);
        }


        /* ==========================================
           PORTADA 4
           SONIDO E IMAGEN
        ========================================== */

        .cover-sonido {
            background:
                radial-gradient(
                    circle at 12% 25%,
                    #71b9e1,
                    transparent 42%
                ),

                radial-gradient(
                    circle at 84% 16%,
                    #eb72ad,
                    transparent 38%
                ),

                radial-gradient(
                    circle at 65% 82%,
                    #f28cc2,
                    transparent 38%
                ),

                linear-gradient(
                    145deg,
                    #72badf,
                    #baafe3,
                    #ef73ad
                );
        }

        .star {
            position: absolute;

            display: flex;
            align-items: center;
            justify-content: center;

            width: 62px;
            height: 62px;

            font-size: 54px;
            line-height: 1;

            filter:
                drop-shadow(
                    0 8px 6px
                    rgba(58,32,65,0.15)
                );
        }

        .star1 { color: #ffe173; left: 12%; top: 13%; transform: rotate(-12deg); }
        .star2 { color: #fff5eb; left: 58%; top: 13%; transform: rotate(13deg); }
        .star3 { color: #ef4e91; left: 30%; top: 45%; font-size: 80px; transform: rotate(-8deg); }
        .star4 { color: #5c76bd; right: 8%; bottom: 11%; font-size: 72px; transform: rotate(15deg); }
        .star5 { color: #ff784a; left: 8%; bottom: 4%; transform: rotate(10deg); }


        /* ==========================================
           PORTADA 5: LÁMPARA RAPUNZEL
        ========================================== */

        .cover-lampara {
            background:
                radial-gradient(
                    circle at 50% 50%,
                    #ffe89d 0%,
                    #ff9e42 40%,
                    #59253d 80%
                );
        }

        .cover-lampara::after {
            content: "💡";
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            font-size: 65px;
            filter: drop-shadow(0 0 15px rgba(255, 235, 120, 0.8));
        }


        /* ==========================================
           PORTADA 6: SUPERNOVA GAME
        ========================================== */

        .cover-juego {
            background:
                radial-gradient(
                    circle at 30% 30%,
                    #ff9dc8 0%,
                    #76516f 40%,
                    #1b0f26 85%
                );
        }

        .cover-juego::after {
            content: "🚀";
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%) rotate(45deg);
            font-size: 65px;
            filter: drop-shadow(0 5px 15px rgba(255, 150, 200, 0.4));
        }


        /* ==========================================
           ETIQUETA EN PORTADAS
        ========================================== */

        .cover-label {
            position: absolute;
            left: 14px;
            bottom: 14px;

            padding: 7px 11px;

            border-radius: 100px;

            background:
                rgba(255,250,242,0.82);

            backdrop-filter: blur(10px);

            font-size: 0.68rem;

            text-transform: uppercase;

            letter-spacing: 1px;

            font-weight: bold;

            color: #64404f;
            z-index: 2;
        }


        /* ==========================================
           INFORMACIÓN DE LAS CARDS
        ========================================== */

        .card-content {
            display: flex;
            flex-direction: column;
            flex-grow: 1;

            padding: 9px 20px 22px;
        }

        .numero {
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;

            color: #a78292;

            font-size: 0.77rem;

            margin-bottom: 7px;
        }

        .card-title {
            font-family: Georgia, "Times New Roman", serif;

            font-size: 1.36rem;

            font-weight: normal;

            color: #b52e67;

            margin-bottom: 10px;
        }

        .card-description {
            color: #624b56;

            font-size: 0.88rem;

            line-height: 1.55;

            flex-grow: 1;

            margin-bottom: 20px;
        }


        /* ==========================================
           BOTONES
        ========================================== */

        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;

            width: 100%;

            padding: 10px 12px 10px 16px;

            border-radius: 100px;

            text-decoration: none;

            font-size: 0.84rem;

            font-weight: bold;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #e53f83,
                    #ff7957
                );

            box-shadow:
                0 8px 20px
                rgba(218,52,118,0.22);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 12px 26px
                rgba(218,52,118,0.3);
        }

        .arrow {
            width: 30px;
            height: 30px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                rgba(255,255,255,0.2);
        }


        /* ==========================================
           FOOTER
        ========================================== */

        footer {
            padding: 20px 20px 50px;

            text-align: center;

            font-family: Georgia, serif;

            font-style: italic;

            color: #745665;
        }

        footer .footer-star {
            display: block;

            color: #dd4f88;

            font-size: 26px;

            margin-bottom: 8px;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 1200px) {
            .portfolio-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        @media (max-width: 650px) {

            header {
                min-height: 420px;
                padding: 60px 15px 45px;
            }

            .nombre {
                font-size: 0.75rem;
                letter-spacing: 3px;
            }

            .titulo-revista {
                gap: 3px;
            }

            .letra {
                min-width: 32px;
                height: 49px;
                font-size: 2.35rem;
                padding: 4px 6px;
            }

            .espacio {
                width: 10px;
            }

            .asignatura {
                font-size: 1rem;
            }

            .container {
                width: calc(100% - 26px);
            }

            .section-header {
                display: block;
            }

            .section-header span {
                display: block;
                margin-top: 8px;
            }

            .portfolio-grid {
                grid-template-columns: 1fr;
            }

            .cover {
                height: 330px;
            }

        }

    </style>

</head>


<body>


